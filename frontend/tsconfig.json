{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2022", "DOM"],
    "module": "ESNext", "skipLibCheck": true, "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false, "resolveJsonModule": true, "isolatedModules": true,
    "esModuleInterop": true, "jsx": "react-jsx", "strict": true, "noEmit": true
  },
  "include": ["src"],
  "references": [{"path": "./tsconfig.node.json"}]
}
