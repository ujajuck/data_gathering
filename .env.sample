# 실제 값은 .env(git 미추적)에 둔다. 서버·CLI는 시작할 때 <workspace>/.env, ./.env를 읽는다
# (schema/env.py; 이미 export된 변수가 우선).
# 읽는 접두는 SCHEMA_ 하나뿐이다 — 옛 이름(KG_V3_*·KG_V2_*·KG_E2E_*·KG_DRM_*)은 폴백하지 않고,
# 설정돼 있으면 시작할 때 경고만 하고 무시한다.
# 사용자 접근 토큰은 없다: 메인 API(python -m schema serve)는 인증하지 않고 기본으로 127.0.0.1에만 바인딩한다.
# 다른 host로 열려면 앞단(리버스 프록시 등)에 인증을 두는 것은 운영자 책임이다.
# 옛 SCHEMA_ACCESS_TOKEN은 SCHEMA_RENDER_TOKEN으로 이름이 바뀌었다(메인 API 인증이 없어져 렌더 서버 내부
# bearer만 남았다). 옛 이름만 설정돼 있으면 이번 릴리스까지는 그 값을 쓰고 경고를 남긴다 — 이름을 바꿔 두자.

SCHEMA_ALLOWED_HOSTS=       # /api/*가 받아 줄 Host 목록(쉼표 구분). 비우면 127.0.0.1·localhost·[::1]만 받는다.
                            # 앞단 프록시를 쓰면 그 호스트 이름을 여기 적는다(없으면 400 HOST_NOT_ALLOWED).

# python -m schema serve / render-serve
SCHEMA_RENDER_URL=          # 별도 렌더 서버 주소(예: http://127.0.0.1:8032). 비우면 같은 프로세스의 렌더 워커 사용
SCHEMA_RENDER_TOKEN=        # 렌더 서버와 메인 서버가 주고받는 내부 bearer(서버 대 서버 전용, 브라우저는 보내지 않는다).
                            # 루프백이 아닌 주소로 render-serve를 열려면 이 값이 반드시 있어야 한다(403 RENDER_TOKEN_REQUIRED).
SCHEMA_RENDER_CONCURRENCY=1 # Excel COM 경로는 1 권장
SCHEMA_RENDER_LRU_MB=256    # 렌더 창 메모리 캐시 상한
SCHEMA_RENDER_CACHE_MB=4096 # 렌더 디스크 캐시 상한(오래된 snapshot부터 제거)
SCHEMA_RENDER_MEMORY_MB=128 # 보호 문서 렌더 파생물은 디스크가 아니라 메모리에만 둔다(§3.5(3)). 그 상한.
SCHEMA_RENDER_MEMORY_TTL_SECONDS=300  # 그 메모리에 남겨 두는 시간
SCHEMA_RENDER_QUEUE=32

# Reader — 보호 문서(DRM)가 기본이고 평문 OOXML이 예외다. 어댑터가 없을 때만 DRM_READER_REQUIRED로 남는다.
# 연결 상태는 설정 화면의 Reader 카드와 `python -m schema drm-probe`로 확인한다.
SCHEMA_READER_FACTORY=      # 보안 읽기 어댑터: <모듈>:<함수> 하나(예: approved_package.reader:factory).
                            # 비우면 기본 Reader(local-xlsx 평문)만 쓰고 보호 문서는 전부 잠긴다.
                            # 저장소 안의 윈도우 Excel COM 참조 구현을 쓰려면 schema.drm:excel_com_reader
SCHEMA_READER_REVISION=     # Reader 코드/환경의 고정 버전(설정 화면·감사 표시용)
SCHEMA_READER_TIMEOUT_SECONDS=120
SCHEMA_READER_MEMORY_MB=1536
SCHEMA_READER_CONTEXT=      # Reader 프로세스 시작 방식(기본 forkserver, spawn으로 되돌릴 수 있다 — COM 경로는 spawn 권장)

# 보호 문서 해제 세션 — 해제본은 작업 공간 밖 0700 폴더에만 만들고 snapshot마다 한 번만 해제한다.
SCHEMA_DRM_MAGIC=           # 평문처럼 보이는 벤더 컨테이너 시그니처 목록(쉼표 구분). 항목은 hex:<16진> 또는 ascii:<문자열>,
                            # 접두가 없으면 ASCII로 본다(항목당 32바이트 이하). PK·OLE2보다 먼저 검사한다.
                            # 예: SCHEMA_DRM_MAGIC=hex:0a0b0c0d,ascii:NASCA — 실제 값은 DRM 운영 담당자에게 확인한다
SCHEMA_DRM_TEMP_DIR=        # 해제본 임시 폴더(기본 <OS 임시>/schema-drm-<uid>). 작업 공간 안을 가리키면
                            # 시작 시 DRM_TEMP_IN_WORKSPACE로 멈춘다
SCHEMA_DRM_CACHE_TTL_SECONDS=900   # 해제 세션 재사용 시간. 0이면 재사용 없이 연산마다 해제하고 끝나는 즉시 지운다(보안 우선)
SCHEMA_DRM_CACHE_MB=2048           # 해제본 폴더 총량 상한(넘으면 오래 안 쓴 것부터 제거)
SCHEMA_DRM_CACHE_MAX_SESSIONS=64   # 동시에 남겨 두는 해제 세션 수 상한
SCHEMA_DRM_OPEN_TIMEOUT_SECONDS=60 # 해제 한 건의 시간 상한(넘으면 DRM_OPEN_TIMEOUT, Excel 프로세스는 강제 종료)
SCHEMA_DRM_COM_LOCK=        # Excel COM 구간 직렬화 잠금 파일(기본 <SCHEMA_DRM_TEMP_DIR>/com.lock)

# 등록·기타
SCHEMA_REGISTER_DIRECTORY_LIMIT=10000  # 폴더 일괄 등록(문서 → 이 폴더 전체 등록 / python -m schema register) 한 번의 대상 파일 상한.
                            # 넘으면 413과 함께 하위 폴더를 나누어 등록하라고 안내한다(스캔이 걸을 수 있는 항목 수 200,000개는 고정)
SCHEMA_PRINCIPAL=local-user
