# 실제 값은 .env(git 미추적)에 둔다.
KG_DRM_MAGIC=         # 벤더 DRM 시그니처(선두 바이트, 콤마 구분) — 미설정 시 판별 꺼짐
ANTHROPIC_API_KEY=    # LLM 매핑 보조 판정 (선택)

# v2 독립 서버 (python -m kg.v2)와 kg.webapp은 시작 시 <workspace>/.env, ./.env를 자동으로 읽는다
# (kg/env.py; 이미 export된 변수가 우선, 의존성 없음).
KG_V2_READER_FACTORY=  # 운영자 등록 DRM Reader: approved_package.reader:factory
KG_V2_READER_REVISION= # Reader 코드/환경의 고정 버전
KG_V2_READER_TIMEOUT_SECONDS=120
KG_V2_READER_MEMORY_MB=1536
KG_V2_ACCESS_TOKEN=    # 로컬 PoC 외 접근 시 사용할 선택적 Bearer 토큰
KG_V2_PRINCIPAL=local-user

# v3 (python -m kg.v3 serve / render-serve). 없으면 KG_V2_* 값을 대신 읽는다.
KG_V3_RENDER_URL=          # 별도 렌더 서버 주소(예: http://127.0.0.1:8032). 비우면 같은 프로세스의 렌더 워커 사용
KG_V3_READER_FACTORY=      # 운영자 등록 DRM Reader: approved_package.reader:factory (기본 Reader는 local-xlsx만)
KG_V3_READER_TIMEOUT_SECONDS=120
KG_V3_READER_MEMORY_MB=1536
KG_V3_RENDER_CONCURRENCY=1 # Excel COM 경로는 1 권장
KG_V3_RENDER_LRU_MB=256    # 렌더 창 메모리 캐시 상한
KG_V3_RENDER_CACHE_MB=4096 # 렌더 디스크 캐시 상한(오래된 snapshot부터 제거)
KG_V3_RENDER_QUEUE=32
KG_V3_ACCESS_TOKEN=        # 선택적 Bearer 토큰
KG_V3_PRINCIPAL=local-user
